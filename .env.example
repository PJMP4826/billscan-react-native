# URL base del API de BillScan. Incluye el prefijo /api y no agregues slash final.
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# true = usa los datos mock incluidos; false = consume el API real.
EXPO_PUBLIC_USE_MOCKS=true

# Clave pública de Clerk para autenticar usuarios en la aplicación.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test...
