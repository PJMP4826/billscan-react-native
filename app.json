{
  "expo": {
    "name": "BillScan",
    "slug": "billscan-react-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/billscan-logo.png",
    "scheme": "billscanreactnative",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/billscan-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c356a"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/billscan-logo.png",
        "backgroundColor": "#0c356a"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.billscanreactnative"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/billscan-logo.png",
      "config": {
        "pwa": {
          "name": "BillScan",
          "shortName": "BillScan",
          "description": "Escanea y gestiona tus facturas de forma rápida.",
          "lang": "es-MX",
          "startUrl": "/",
          "display": "standalone",
          "orientation": "portrait",
          "backgroundColor": "#0c356a",
          "themeColor": "#0c356a",
          "icons": [
            {
              "src": "./assets/images/billscan-logo.png",
              "sizes": "192x192",
              "type": "image/png"
            },
            {
              "src": "./assets/images/billscan-logo.png",
              "sizes": "512x512",
              "type": "image/png"
            }
          ]
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d1681a7a-3444-45ed-92e2-3cbcef5259ea"
      }
    }
  }
}
