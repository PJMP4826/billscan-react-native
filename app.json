{
  "expo": {
    "name": "BillScan",
    "slug": "billscan-react-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/billiscan-icon-512.png",
    "scheme": "billscanreactnative",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "BillScan utiliza la cámara para escanear tu constancia de situación fiscal."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/billiscan-icon-512.png",
        "backgroundColor": "#0c356a"
      },
      "permissions": ["android.permission.CAMERA", "com.android.vending.BILLING"],
      "predictiveBackGestureEnabled": false,
      "package": "com.billscan"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/billscan-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/billscan-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#275fa9"
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "BillScan necesita acceso a tus fotos para adjuntar tu constancia fiscal.",
          "cameraPermission": "BillScan utiliza la cámara para escanear tu constancia de situación fiscal."
        }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d1681a7a-3444-45ed-92e2-3cbcef5259ea"
      }
    }
  }
}
