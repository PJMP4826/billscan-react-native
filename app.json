{
  "expo": {
    "name": "BillScan",
    "slug": "billscan-react-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/ios/AppIcon~ios-marketing.png",
    "scheme": "billscanreactnative",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "BillScan utiliza la cámara para escanear tu constancia de situación fiscal."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/android/res/mipmap-xxxhdpi/ic_launcher_foreground.png",
        "monochromeImage": "./assets/icons/android/res/mipmap-xxxhdpi/ic_launcher_monochrome.png",
        "backgroundColor": "#275fa9"
      },
      "permissions": [
        "android.permission.CAMERA",
        "com.android.vending.BILLING"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.billscan",
    "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icons/web/icon-192.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/billscan-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#275fa9"
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "BillScan necesita acceso a tus fotos para adjuntar tu constancia fiscal.",
          "cameraPermission": "BillScan utiliza la cámara para escanear tu constancia de situación fiscal."
        }
      ],
      "expo-document-picker",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/android/res/notification-icon.png",
          "color": "#275fa9",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d1681a7a-3444-45ed-92e2-3cbcef5259ea"
      }
    }
  }
}
